          "name": "Authentication",
          "item": [
            {
              "name": "get-access-token",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const jsonResponse = pm.response.json();",
                      "const tokenSchema = pm.collectionVariables.get(\"tokenSchema\");",
                      "const tokenSchemaJson = tokenSchema ? JSON.parse(tokenSchema) : null;",
                      "",
                      "const accessToken = jsonResponse.access_token || \"\";",
                      "const expires_in = jsonResponse.expires_in || \"\";",
                      "const token_type = jsonResponse.token_type || \"\";",
                      "const scope = jsonResponse.scope || \"public private\";",
                      "",
                      "pm.test(\"Access token is available\", function () {",
                      "    pm.expect(accessToken, \"access_token\").to.be.a(\"string\").and.not.empty;",
                      "    pm.environment.set(\"accessToken\",accessToken)",
                      "});",
                      "",
                      "pm.test(\"Validate the access code for success response\", function() {",
                      "    pm.response.to.have.status(200);",
                      "})",
                      "",
                      "pm.test(\"Validate the response time\", function () {",
                      "     pm.expect(pm.response.responseTime).to.be.below(5000);",
                      "});",
                      "",
                      "pm.test(\"Validate the response schema\", function () {",
                      "    pm.response.to.have.jsonSchema(tokenSchemaJson);",
                      "});",
                      "",
                      "pm.test(\"Validate availability of properties\", function() {",
                      "    pm.expect(jsonResponse).to.have.property(\"access_token\");",
                      "    pm.expect(jsonResponse).to.have.property(\"expires_in\");",
                      "    pm.expect(jsonResponse).to.have.property(\"token_type\");",
                      "    pm.expect(jsonResponse).to.have.property(\"scope\");",
                      "})",
                      "",
                      "pm.test(\"Validate values in response body\", function() {",
                      "   pm.expect(jsonResponse.expires_in).to.be.eql(3600);",
                      "   pm.expect(jsonResponse.token_type).to.be.eql(\"Bearer\");",
                      "   pm.expect(jsonResponse.scope).to.be.eql(\"public private\");",
                      "})",
                      "",
                      "pm.test(\"Content-Type is application/json\", function () {",
                      "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                      "});",
                      "",
                      ""
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
